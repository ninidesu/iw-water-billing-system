# Required — copy these values into Vercel → Project Settings → Environment Variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Optional public office information.
VITE_OFFICE_ADDRESS=
VITE_OFFICE_CONTACT=
VITE_OFFICE_EMAIL=

# Optional public homepage advisory.
VITE_SERVICE_ADVISORY=

# Optional HTTPS payment-provider page that accepts the CAN as reference.
VITE_BILLER_PAYMENT_URL=

# Never add a Supabase service-role key to a VITE_ variable.
